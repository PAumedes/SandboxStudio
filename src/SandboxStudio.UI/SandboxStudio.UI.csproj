<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ApplicationIcon>Assets\SandboxStudio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- None: the portable exe (default). MSIX: the Microsoft Store package (scripts/package-msix.ps1). -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!--
      MRT Core looks for <exe name>.pri before falling back to resources.pri.
      The default name (SandboxStudio.UI.pri) crashes XAML startup as soon as
      the exe is renamed, e.g. to the versioned release download name.
    -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <!--
    Publishing produces one portable SandboxStudio.UI.exe: the runtime, the
    Windows App SDK payload, and the app's content files are bundled and
    extracted to %TEMP%\.net on first launch. Requires Windows App SDK 1.5+
    (verified on 2.5.1; 1.6 failed WinRT activation from a bundle).
  -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    The Store package is uploaded unsigned: Partner Center signs it with
    Microsoft's certificate. Plain per-architecture .msix files (accepted by
    Partner Center) rather than a .msixupload: the upload container and the
    symbols package both need Visual Studio's MSBuild, not the dotnet CLI.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
  </PropertyGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <Content Include="Assets\Package\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SandboxStudio.Core\SandboxStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SandboxStudio.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SandboxStudio-32.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="WinUIEx" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
