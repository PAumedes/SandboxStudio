<ContentDialog
    x:Class="SandboxStudio.UI.Views.SessionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sandbox sessions"
    CloseButtonText="Close"
    DefaultButton="Close"
    Opened="OnOpened">

    <StackPanel MinWidth="480" Spacing="12">
        <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Center" />

        <InfoBar
            x:Name="StatusInfoBar"
            Severity="Informational"
            IsOpen="False"
            IsClosable="False" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Refresh" Click="OnRefreshClicked" />
        </StackPanel>

        <ListView x:Name="SessionsList" MaxHeight="320" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Glyph="{Binding StateGlyph}"
                            FontSize="14"
                            VerticalAlignment="Center"
                            Foreground="{Binding StateBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding IdShort}" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{Binding DetailText}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Content="Connect"
                            IsEnabled="{Binding CanConnect}"
                            Click="OnConnectClicked" />
                        <Button
                            Grid.Column="3"
                            Content="Stop"
                            IsEnabled="{Binding CanStop}"
                            Click="OnStopClicked" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
