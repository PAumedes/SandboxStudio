<ContentDialog
    x:Class="SandboxStudio.UI.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="SettingsDialog"
    DefaultButton="Primary">

    <StackPanel MinWidth="440" Spacing="16">
        <TextBlock
            x:Name="ErrorTextBlock"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

        <ComboBox
            x:Name="ThemeComboBox"
            x:Uid="ThemeComboBox"
            HorizontalAlignment="Stretch"
            SelectionChanged="OnThemeSelectionChanged"
            PointerWheelChanged="OnComboBoxWheel">
            <ComboBoxItem x:Uid="ThemeSystemItem" Tag="" />
            <ComboBoxItem x:Uid="ThemeLightItem" Tag="Light" />
            <ComboBoxItem x:Uid="ThemeDarkItem" Tag="Dark" />
        </ComboBox>

        <StackPanel Spacing="8">
            <ComboBox
                x:Name="LanguageComboBox"
                x:Uid="LanguageComboBox"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnLanguageSelectionChanged"
                PointerWheelChanged="OnComboBoxWheel">
                <ComboBoxItem x:Uid="LanguageSystemComboItem" Tag="" />
                <ComboBoxItem x:Uid="LanguageEnglishComboItem" Tag="en-US" />
                <ComboBoxItem x:Uid="LanguageSpanishComboItem" Tag="es-ES" />
            </ComboBox>
            <TextBlock
                x:Name="LanguageRestartHint"
                x:Uid="LanguageRestartHint"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <Button
            x:Uid="ShowQuickStartButton"
            Click="OnShowQuickStartClicked"
            HorizontalAlignment="Left" />

        <Border
            Padding="16"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image
                        Source="ms-appx:///Assets/SandboxStudio-32.png"
                        Width="32"
                        Height="32"
                        Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="SandboxStudio" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="VersionTextBlock"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    x:Uid="AboutDescription"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    x:Uid="AboutProjectLink"
                    NavigateUri="https://github.com/PAumedes/SandboxStudio"
                    Padding="0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
