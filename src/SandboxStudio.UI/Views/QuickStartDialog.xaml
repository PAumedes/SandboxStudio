<ContentDialog
    x:Class="SandboxStudio.UI.Views.QuickStartDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="QuickStartDialog"
    DefaultButton="Primary">

    <StackPanel MinWidth="440" MaxWidth="480" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image
                Source="ms-appx:///Assets/SandboxStudio-32.png"
                Width="40"
                Height="40"
                Stretch="Uniform" />
            <TextBlock
                x:Uid="QuickStartIntro"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{ThemeResource AccentAAFillColorDefaultBrush}">
                    <TextBlock
                        Text="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    x:Uid="QuickStartStep1"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{ThemeResource AccentAAFillColorDefaultBrush}">
                    <TextBlock
                        Text="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    x:Uid="QuickStartStep2"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{ThemeResource AccentAAFillColorDefaultBrush}">
                    <TextBlock
                        Text="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    x:Uid="QuickStartStep3"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <CheckBox x:Name="DontShowAgainCheckBox" x:Uid="QuickStartDontShowCheckBox" />
    </StackPanel>
</ContentDialog>
