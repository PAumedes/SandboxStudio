<Window
    x:Class="SandboxStudio.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:SandboxStudio.UI.Converters"
    xmlns:models="using:SandboxStudio.Core.Models"
    mc:Ignorable="d"
    Title="SandboxStudio">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="44,Auto,*,Auto">
        <Grid.Resources>
            <conv:TagsToTextConverter x:Key="TagsToText" />
            <conv:TagsToVisibilityConverter x:Key="TagsToVisibility" />
        </Grid.Resources>
        <Grid
            x:Name="TitleBarDragRegion"
            Grid.Row="0"
            Height="44"
            Background="Transparent"
            ColumnDefinitions="Auto,*">
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="ms-appx:///Assets/SandboxStudio-32.png"
                    Width="20"
                    Height="20"
                    Stretch="Uniform" />
                <TextBlock
                    Text="SandboxStudio"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Dashboard Header -->
        <Grid Grid.Row="1" Margin="24,16,24,12" ColumnDefinitions="Auto, *, Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <StackPanel>
                    <TextBlock x:Uid="ProfilesHeading" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock x:Uid="ProfilesCaption" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBox
                Grid.Column="1"
                x:Uid="TagFilterBox"
                Width="240"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="RefreshButton" Command="{x:Bind ViewModel.LoadProfilesCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Uid="ImportButton" Click="OnImportClicked" />
                <Button x:Uid="SessionsButton" Click="OnSessionsClicked" />
                <DropDownButton x:Uid="LanguageButton">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Uid="LanguageSystemDefaultItem" x:Name="LanguageSystemDefaultItem" GroupName="Language" Click="OnLanguageClicked" Tag="" />
                            <RadioMenuFlyoutItem x:Uid="LanguageEnglishItem" x:Name="LanguageEnglishItem" GroupName="Language" Click="OnLanguageClicked" Tag="en-US" />
                            <RadioMenuFlyoutItem x:Uid="LanguageSpanishItem" x:Name="LanguageSpanishItem" GroupName="Language" Click="OnLanguageClicked" Tag="es-ES" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.CreateProfileCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="NewProfileText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: Profiles Grid -->
        <ScrollViewer Grid.Row="2" Padding="24,8,24,16">
            <StackPanel Spacing="16">
                <!-- Sandbox Readiness Warning Banner if not detected -->
                <InfoBar
                    x:Name="SandboxStatusInfoBar"
                    x:Uid="SandboxStatusInfoBar"
                    IsOpen="False"
                    Severity="Warning" />

                <!-- Language-change restart notice -->
                <InfoBar
                    x:Name="LanguageRestartInfoBar"
                    x:Uid="LanguageRestartInfoBar"
                    IsOpen="False"
                    Severity="Informational" />

                <!-- New-release banner; only shown when an update exists -->
                <InfoBar
                    x:Name="UpdateInfoBar"
                    x:Uid="UpdateInfoBar"
                    IsOpen="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="UpdateViewButton" Click="OnViewUpdateClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Empty state when the tag filter matches nothing -->
                <InfoBar
                    x:Name="NoMatchingProfilesInfoBar"
                    x:Uid="NoMatchInfoBar"
                    IsOpen="{x:Bind ViewModel.HasNoMatchingProfiles, Mode=OneWay}"
                    Severity="Informational"
                    IsClosable="False" />

                <!-- Profiles ItemsControl -->
                <ItemsRepeater x:Name="ProfilesRepeater" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="320" MinItemHeight="180" MinRowSpacing="16" MinColumnSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:SandboxProfile">
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="16"
                                  RowDefinitions="Auto, *, Auto">

                                <!-- Card Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="20" Margin="0,0,12,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Content="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="EditProfileMenuItem" Click="OnEditClicked" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="DuplicateMenuItem" Click="OnDuplicateClicked" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="ExportMenuItem" Click="OnExportClicked" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74E;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="DeleteProfileMenuItem" Click="OnDeleteClicked" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Card Description and Tags -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                                    <TextBlock Text="{x:Bind Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Tags, Converter={StaticResource TagsToText}}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                               Margin="0,4,0,0"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Tags, Converter={StaticResource TagsToVisibility}}" />
                                </StackPanel>

                                <!-- Card Footer: Quick Actions -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Configuration.Networking, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Click="OnLaunchClicked" Tag="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock x:Uid="LaunchText" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,6">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SandboxEngineStatus" Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
