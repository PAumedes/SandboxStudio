<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Assembly Metadata -->
    <Authors>SandboxStudio Contributors</Authors>
    <Company>SandboxStudio</Company>
    <Product>SandboxStudio</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright © 2026 SandboxStudio Contributors</Copyright>
    <RepositoryUrl>https://github.com/PAumedes/SandboxStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Deterministic build in CI -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
